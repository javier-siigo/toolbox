# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private (server-only, nunca expuesta al cliente).
# Usos:
#   - Admin API: signed upload URLs y lectura del bucket `notas-credito-uploads`.
#   - Script `npm run import:retirados` (importa el reporte de Contabilidad
#     a la tabla `colaboradores_retirados`).
SUPABASE_SERVICE_ROLE_KEY=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_NOTAS_CREDITO_PATH=

# NetSuite (OAuth 2.0 client credentials / M2M). Server-only.
# Usado por /api/export-bancos (Ingresos › Movimientos bancarios NetSuite).
NETSUITE_ACCOUNT_ID=6389340
NETSUITE_CONSUMER_KEY=
# kid del certificado cargado en NetSuite (Setup › Integration › OAuth 2.0 Client Credentials).
NETSUITE_CERT_ID=
# PEM PKCS#8. Puede ir en una sola línea (con o sin "\n" literales).
NETSUITE_PRIVATE_KEY=

# Bucket privado de Supabase Storage para los Excel generados.
EXPORTS_BUCKET=exports

# Vercel Cron: /api/cron/limpiar-storage borra a diario uploads y exports de más de 1 día.
# Vercel lo envía como `Authorization: Bearer $CRON_SECRET`. Sin valor, la ruta responde 401.
CRON_SECRET=
